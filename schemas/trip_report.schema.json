{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartlane.ai/schemas/trip-report.schema.json",
  "title": "Smartlane Trip Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "video_id",
    "processing_mode",
    "duration_seconds",
    "score",
    "behavior_events",
    "incidents",
    "responsibility_assessments",
    "summary"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "processing_mode": {
      "type": "string",
      "enum": [
        "batch",
        "live"
      ]
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "score": {
      "$ref": "#/$defs/driverScore"
    },
    "behavior_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behaviorEvent"
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/incident"
      }
    },
    "responsibility_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/responsibility"
      }
    },
    "summary": {
      "type": "string"
    },
    "generated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "$defs": {
    "driverScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "following_score",
        "braking_score",
        "acceleration_score",
        "lane_behavior_score",
        "interaction_score",
        "incident_score",
        "rating"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "following_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "braking_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "acceleration_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "lane_behavior_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "interaction_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "incident_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "rating": {
          "type": "string",
          "enum": [
            "EXCELLENT",
            "GOOD",
            "MODERATE",
            "POOR",
            "CRITICAL"
          ]
        }
      }
    },
    "behaviorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "behavior_type",
        "subject",
        "start_frame",
        "end_frame",
        "start_time_seconds",
        "end_time_seconds",
        "confidence"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "behavior_type": {
          "type": "string"
        },
        "subject": {
          "type": "object"
        },
        "start_frame": {
          "type": "integer"
        },
        "end_frame": {
          "type": "integer"
        },
        "start_time_seconds": {
          "type": "number"
        },
        "end_time_seconds": {
          "type": "number"
        },
        "magnitude": {
          "type": ["number", "null"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "related_vehicle_ids": {
          "type": "array"
        },
        "evidence": {
          "type": "object"
        }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "start_frame",
        "end_frame",
        "start_time_seconds",
        "end_time_seconds",
        "involved_vehicle_ids",
        "incident_type",
        "severity",
        "confidence"
      ],
      "properties": {
        "incident_id": {
          "type": "string"
        },
        "start_frame": {
          "type": "integer"
        },
        "end_frame": {
          "type": "integer"
        },
        "start_time_seconds": {
          "type": "number"
        },
        "end_time_seconds": {
          "type": "number"
        },
        "involved_vehicle_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "incident_type": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "related_behavior_event_ids": {
          "type": "array"
        },
        "related_interaction_ids": {
          "type": "array"
        },
        "evidence": {
          "type": "object"
        }
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "classification",
        "confidence",
        "reasoning"
      ],
      "properties": {
        "incident_id": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasoning": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  }
}