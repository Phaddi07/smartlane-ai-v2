{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartlane.ai/schemas/incident.schema.json",
  "title": "Smartlane Incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "start_frame",
    "end_frame",
    "start_time_seconds",
    "end_time_seconds",
    "involved_vehicle_ids",
    "incident_type",
    "severity",
    "confidence"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "start_frame": {
      "type": "integer",
      "minimum": 0
    },
    "end_frame": {
      "type": "integer",
      "minimum": 0
    },
    "start_time_seconds": {
      "type": "number",
      "minimum": 0
    },
    "end_time_seconds": {
      "type": "number",
      "minimum": 0
    },
    "involved_vehicle_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "collision_candidate",
        "near_collision",
        "unsafe_following",
        "lane_conflict",
        "interaction",
        "unknown"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "related_behavior_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_interaction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    }
  }
}