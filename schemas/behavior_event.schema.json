{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartlane.ai/schemas/behavior-event.schema.json",
  "title": "Smartlane Behavior Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "behavior_type",
    "subject",
    "start_frame",
    "end_frame",
    "start_time_seconds",
    "end_time_seconds",
    "confidence"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "behavior_type": {
      "type": "string",
      "enum": [
        "braking",
        "acceleration",
        "lane_change",
        "following",
        "cut_in",
        "merge",
        "sudden_movement"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "start_frame": {
      "type": "integer",
      "minimum": 0
    },
    "end_frame": {
      "type": "integer",
      "minimum": 0
    },
    "start_time_seconds": {
      "type": "number",
      "minimum": 0
    },
    "end_time_seconds": {
      "type": "number",
      "minimum": 0
    },
    "magnitude": {
      "type": ["number", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "related_vehicle_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "evidence": {
      "type": "object"
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ego",
            "vehicle"
          ]
        },
        "id": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}