{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartlane.ai/schemas/ego-state.schema.json",
  "title": "Smartlane Ego State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frame_number",
    "timestamp_seconds",
    "motion_state",
    "confidence"
  ],
  "properties": {
    "frame_number": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_seconds": {
      "type": "number",
      "minimum": 0
    },
    "speed_mps": {
      "type": ["number", "null"]
    },
    "acceleration_mps2": {
      "type": ["number", "null"]
    },
    "heading_degrees": {
      "type": ["number", "null"]
    },
    "lane_id": {
      "type": ["integer", "null"]
    },
    "motion_state": {
      "type": "string",
      "enum": [
        "stationary",
        "moving",
        "accelerating",
        "decelerating",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "object"
    }
  }
}