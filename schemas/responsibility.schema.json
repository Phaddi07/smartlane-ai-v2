{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartlane.ai/schemas/responsibility.schema.json",
  "title": "Smartlane Responsibility Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "classification",
    "confidence",
    "reasoning"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "enum": [
        "pov_primary",
        "other_vehicle_primary",
        "shared_contribution",
        "no_contribution_by_pov",
        "indeterminate"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning": {
      "type": "string"
    },
    "evidence": {
      "type": "object"
    }
  }
}