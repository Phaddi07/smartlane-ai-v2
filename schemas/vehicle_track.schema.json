{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartlane.ai/schemas/vehicle-track.schema.json",
  "title": "Smartlane Vehicle Track",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track_id",
    "vehicle_type",
    "is_ego",
    "observations"
  ],
  "properties": {
    "track_id": {
      "type": "integer",
      "minimum": 0
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "car",
        "truck",
        "bus",
        "motorcycle",
        "bicycle",
        "unknown"
      ]
    },
    "is_ego": {
      "type": "boolean"
    },
    "first_frame": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "last_frame": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": { "type": "number" },
        "y1": { "type": "number" },
        "x2": { "type": "number" },
        "y2": { "type": "number" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_number",
        "timestamp_seconds",
        "bbox",
        "confidence"
      ],
      "properties": {
        "frame_number": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_seconds": {
          "type": "number",
          "minimum": 0
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vehicle_type": {
          "type": "string",
          "enum": [
            "car",
            "truck",
            "bus",
            "motorcycle",
            "bicycle",
            "unknown"
          ]
        }
      }
    }
  }
}